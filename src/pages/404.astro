---
// Built as 404.html. Cloudflare serves it, with a real 404 status, for any
// path that has no file — which, with every page prerendered, is exactly the
// paths that don't exist.
import BaseLayout from "@/layouts/BaseLayout.astro"
import { SITE_NAME } from "@/lib/site"
---

<BaseLayout
  title={`Page not found · ${SITE_NAME}`}
  noindex
>
  <main class="mx-auto flex max-w-225 flex-col items-center gap-6 px-5 py-20 text-center">
    <p class="text-eyebrow text-muted-foreground">Error 404</p>
    <h1 class="text-balance">Lost in the Labyrinth</h1>
    <p class="max-w-120 text-lg text-muted-foreground">
      No figure in the atlas answers to this name. The thread leads back the way
      you came.
    </p>
    <a
      href="/"
      class="font-accent text-lg text-god underline underline-offset-4 hover:text-gold-white"
    >
      Return to the atlas
    </a>
  </main>
</BaseLayout>
