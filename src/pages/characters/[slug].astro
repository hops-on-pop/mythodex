---
import { JupiterIcon, ShieldEnergyIcon } from "@hugeicons/core-free-icons"
import type { GetStaticPaths } from "astro"
import { getImage } from "astro:assets"

import CardFamily from "@/components/CardFamily.astro"
import CardStat from "@/components/CardStat.astro"
import Portrait from "@/components/Portrait.astro"
import { Separator } from "@/components/starwind/separator"
import { characterList } from "@/data/characters"
import type { Character } from "@/data/types"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { familyOf } from "@/lib/graph"
import { portraitOf } from "@/lib/portraits"
import { SITE_NAME, publicPath } from "@/lib/site"

// One page per figure, written out at build time. A slug that isn't here has
// no file, so the host serves the 404 page with a real 404 status.
export const getStaticPaths = (() =>
  characterList.map((character) => ({
    params: { slug: character.slug },
    props: { character },
  }))) satisfies GetStaticPaths

interface Props {
  character: Character
}

const { character } = Astro.props
const {
  slug,
  name,
  epithet,
  pronunciation,
  category,
  domains,
  symbols,
  blurb,
  body,
  facts,
} = character

// Derived, never authored — the reverse index in lib/graph.ts is what turns
// one-directional `parent-of` edges into parents and siblings.
const family = familyOf(slug)
const portrait = portraitOf(slug)

// Link previews want a plain JPEG: not every platform reads AVIF or WebP.
const preview = portrait
  ? await getImage({ src: portrait, width: 600, format: "jpg", quality: 70 })
  : undefined

const pageUrl = Astro.site
  ? new URL(publicPath(Astro.url), Astro.site).href
  : undefined
const imageUrl =
  Astro.site && preview ? new URL(preview.src, Astro.site).href : undefined

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${name}, ${epithet}`,
  description: blurb,
  url: pageUrl,
  about: {
    "@type": "Thing",
    name,
    alternateName: character.romanName,
    description: blurb,
    image: imageUrl,
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: SITE_NAME,
        item: Astro.site?.href,
      },
      { "@type": "ListItem", position: 2, name, item: pageUrl },
    ],
  },
}
---

<BaseLayout
  title={`${name}, ${epithet} · ${SITE_NAME}`}
  description={blurb}
  image={preview?.src}
  jsonLd={jsonLd}
>
  {/* The gutter lives on this wrapper rather than as a margin on the sheet.
      Two reasons: `mx-*` on a `w-full` element adds to 100% and overflows,
      and the torn edge is a pseudo-element that bleeds ~15px past the sheet's
      box — without real space either side it would clip on the viewport. */}
  <div class="px-6 md:px-10 xl:px-12">
    <main
      data-category={category}
      class="parchment-sheet surface-parchment mx-auto my-10 w-full max-w-350 px-5 py-10 md:px-8 md:py-12 xl:px-12"
    >
      <div
        aria-hidden="true"
        class="meander meander-square meander-fade h-8 text-cat"
      ></div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 w-full py-8">
        {/* min-w-0 on each column — grid tracks default to min-width:auto, so
            a long name or an unbreakable link would widen the track instead
            of wrapping, and push the sheet past the viewport. */}
        {/* At md the grid is 2 up, so the name takes the whole first row —
            otherwise the cards land under it and leave a dead quadrant
            beside the portrait. At xl it's a column again. */}
        <div class="flex flex-col min-w-0 md:col-span-2 xl:col-span-1">
          {/* Which seal this is comes from data-category on <main>, so there
              is nothing to pass; text-cat-ink does the tinting. */}
          <div
            role="img"
            aria-label={`${category} badge`}
            class="badge size-24 md:size-28 xl:size-36 text-cat-ink mb-4 mx-auto"
          ></div>

          <h1 class="text-4xl md:text-5xl font-bold text-balance text-ink pt-12">
            {name}
          </h1>

          <p class="text-xl text-cat-ink font-bold pt-2">{epithet}</p>
          <p class="text-pronunciation text-lg text-cat-ink pt-2">
            {pronunciation}
          </p>
          <p class="text-ink text-lg pt-8 pr-6">{blurb}</p>
        </div>
        <div class="flex flex-col min-w-0">
          {/* Fluid below its natural 300px — a fixed w-75 is wider than the
              content box on a 375px screen. */}
          {portrait && (
            <Portrait
              src={portrait}
              sizes="300px"
              priority
              alt={name}
              class="w-full max-w-75 h-112.5 object-cover rounded-lg"
            />
          )}
        </div>
        <div class="flex flex-col gap-8 min-w-0">
          <CardStat
            category={category}
            label="Domains"
            icon={JupiterIcon}
          >
            <div class="grid grid-cols-2">
              {domains.map((domain) => (
                <span>{domain}</span>
              ))}
            </div>
          </CardStat>
          <CardStat
            category={category}
            label="Symbols"
            icon={ShieldEnergyIcon}
          >
            <div class="grid grid-cols-2">
              {symbols.map((symbol) => (
                <span>{symbol}</span>
              ))}
            </div>
          </CardStat>
          <CardFamily
            category={category}
            family={family}
          />
        </div>
      </div>
      <div
        aria-hidden="true"
        class="meander meander-square meander-fade h-8 text-cat"
      ></div>
      <div class="flex flex-col gap-4 pt-8">
        <h2 class="text-2xl font-bold text-cat-ink">The Story</h2>
        <Separator />
        {body.map((paragraph) => (
          <p class="text-ink">{paragraph}</p>
        ))}
      </div>
      <div class="flex flex-col gap-4 pt-10 pb-8">
        <h2 class="text-2xl font-bold text-cat-ink">Did You Know?</h2>
        <Separator />
        <ul class="list-star list-outside pl-6 text-cat-ink">
          {facts.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      </div>
      <div
        aria-hidden="true"
        class="meander meander-square meander-fade h-8 text-cat"
      ></div>
    </main>
  </div>
</BaseLayout>
