---
import { Font } from "astro:assets"

import { SITE_NAME, publicPath } from "@/lib/site"
import "@/styles/global.css"

interface Props {
  title: string
  description?: string
  /** Absolute or root-relative URL of the link-preview image. */
  image?: string
  /** Structured data for search engines, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>
  /** Keep the page out of search results (the 404). */
  noindex?: boolean
}

const { title, description, image, jsonLd, noindex = false } = Astro.props

// Everything absolute hangs off `site` in astro.config.mjs. Without it the
// canonical link and Open Graph URLs are left out rather than guessed.
const site = Astro.site
const path = publicPath(Astro.url)
const canonical = site ? new URL(path, site).href : undefined
const imageUrl = site && image ? new URL(image, site).href : undefined

// One <h1> per page: the site name is the heading only on the home page.
// Everywhere else the page's own title (a character's name) takes it.
const isHome = path === "/"
const Masthead = isHome ? "h1" : "p"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="color-scheme"
      content="dark"
    />
    <meta
      name="theme-color"
      content="#1e1b4b"
    />
    <link
      rel="icon"
      href="/favicon.ico"
      sizes="any"
    />

    <title>{title}</title>
    {description && (
      <meta
        name="description"
        content={description}
      />
    )}
    {noindex && (
      <meta
        name="robots"
        content="noindex"
      />
    )}
    {canonical && !noindex && (
      <link
        rel="canonical"
        href={canonical}
      />
    )}
    {site && (
      <link
        rel="sitemap"
        href="/sitemap-index.xml"
      />
    )}

    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:site_name"
      content={SITE_NAME}
    />
    <meta
      property="og:title"
      content={title}
    />
    {description && (
      <meta
        property="og:description"
        content={description}
      />
    )}
    {canonical && (
      <meta
        property="og:url"
        content={canonical}
      />
    )}
    {imageUrl && (
      <meta
        property="og:image"
        content={imageUrl}
      />
    )}
    <meta
      name="twitter:card"
      content="summary"
    />

    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )}

    {/* Masthead and body copy are above the fold on every page, so those two
        are preloaded. Kalam loads when something uses it. */}
    <Font
      cssVariable="--font-cinzel"
      preload
    />
    <Font
      cssVariable="--font-nunito"
      preload
    />
    <Font cssVariable="--font-kalam" />

    {/* Paints the night sky before the stylesheet arrives, so there's no
        white flash. */}
    <style is:inline>
      html {
        background: #1e1b4b;
      }
    </style>

    <slot name="head" />
  </head>
  <body>
    {/* Deckle edge for .parchment-sheet. CSS `filter: url(#…)` resolves against
        the document, not the stylesheet, so the filter has to be a real node —
        mounted once here rather than per sheet, which would duplicate the id.
        baseFrequency sets the tear's wavelength (~28px), scale its depth
        (±7px); raise scale for a rougher tear, lower it for a clean cut. */}
    <svg
      aria-hidden="true"
      focusable="false"
      class="pointer-events-none absolute size-0"
    >
      <filter
        id="parchment-tear"
        x="-2%"
        y="-2%"
        width="104%"
        height="104%"
        color-interpolation-filters="sRGB"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.035"
          numOctaves="4"
          seed="7"
          result="noise"
        ></feTurbulence>
        <feDisplacementMap
          in="SourceGraphic"
          in2="noise"
          scale="14"
          xChannelSelector="R"
          yChannelSelector="G"
        ></feDisplacementMap>
      </filter>
    </svg>

    <header class="relative isolate overflow-hidden">
      <div
        aria-hidden="true"
        class="meander meander-wave rotate-180 h-8 text-god/70"
      ></div>
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-(image:--gradient-hero-wash)"
      ></div>
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-(image:--gradient-star-field)"
      ></div>

      <div class="mx-auto flex max-w-225 flex-col items-center gap-2 px-5 py-8 text-center">
        <a href="/">
          <Masthead class="text-gradient-title font-display font-bold text-[56px] tracking-[-0.03em] max-lg:text-4xl">
            MythoDex
          </Masthead>
        </a>
        <div class="h-1 w-48 rounded-full bg-(image:--gradient-divider)"></div>
      </div>

      <div
        aria-hidden="true"
        class="meander meander-wave h-8 text-god/70"
      ></div>
    </header>

    <slot />
  </body>
</html>
