---
import type { ComponentProps, HTMLAttributes } from "astro/types"

import Icon from "@/components/Icon.astro"
import type { Character } from "@/data/types"

interface Props extends HTMLAttributes<"div"> {
  category?: Character["category"]
  label?: string
  icon?: ComponentProps<typeof Icon>["icon"]
}

const { class: className, category, label, icon, ...rest } = Astro.props
---

<div
  data-category={category}
  class:list={[
    "rounded-lg border-b-3 border-r-3 border-cat bg-parchment-dark p-3 max-w-sm text-ink flex flex-col gap-1",
    className,
  ]}
  {...rest}
>
  {label && (
    <div class="flex items-center gap-1.5 text-lg uppercase text-cat-ink font-accent">
      {icon && (
        <Icon
          icon={icon}
          size={16}
          strokeWidth={1.75}
          class="mb-1.5"
        />
      )}
      {label}
    </div>
  )}
  <slot />
</div>
