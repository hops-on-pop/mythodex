# Cache rules for Cloudflare (Pages and Workers static assets both read this).
#
# Everything under /_astro/ — CSS, JS, fonts, portraits, the SVG stencils — is
# emitted by Astro with a content hash in its name, so a changed file is a new
# URL. Safe to cache for a year and never revalidate.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, so cache briefly and refresh in the background.
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML pages, robots.txt and the sitemaps keep the host's default (revalidate
# on every request) so a deploy is picked up immediately.
